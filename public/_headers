# Hashed, content-addressed build output (filenames change on every content
# change — see Vite's default [hash] naming) — safe to cache for a full year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/floral-bg.jpg
  Cache-Control: public, max-age=31536000, immutable

# Site-wide security headers. No Content-Security-Policy here: every
# component in this app styles itself via inline `style` attributes (see
# lib/css.js), which a CSP's style-src would block without a broad
# 'unsafe-inline' allowance that defeats most of its own purpose — safer to
# leave it out than ship a policy that's effectively a no-op or, worse,
# silently breaks the entire visual design. The headers below are the ones
# safe to add without touching styling or the Takbull checkout redirect
# (a plain top-level `location.href` navigation, not a popup/iframe).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
